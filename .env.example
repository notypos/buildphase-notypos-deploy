# ---- Models -------------------------------------------------
# Google-direct Gemini. Used for EMBEDDINGS (text-embedding-004, 768 dims)
# and as a generation fallback. https://aistudio.google.com/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# FAU Trussed (OpenAI-compatible proxy). Default generation provider.
# Server-only — never NEXT_PUBLIC.
TRUSSED_BASE_URL=https://fauengtrussed.fau.edu/provider/generic
TRUSSED_API_KEY_OPENAI=your_trussed_openai_project_key_here
TRUSSED_API_KEY_GEMINI=your_trussed_gemini_project_key_here

# ---- Supabase -----------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=your_supabase_project_url_here
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key_here
# Service role — server routes and the ingest script only. Keep secret.
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here

# ---- App ----------------------------------------------------
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Retrieval similarity floor. Below this the app refuses instead of answering.
# Tune against scripts/eval once the corpus is loaded.
RETRIEVAL_MIN_SIMILARITY=0.66
